---
// Unlisted: shared by direct link only. Not in nav, sitemap, or llms files; crawlable by design.
import Base from '../../layouts/Base.astro';
import CvRole from '../../components/CvRole.astro';
import CvTail from '../../components/CvTail.astro';
import { ROLES } from '../../data/roles.js';

export function getStaticPaths() {
  return ROLES.map((role) => ({ params: { slug: role.slug }, props: { role } }));
}

const { role } = Astro.props;
---

<Base
  title={`Resume: ${role.label}`}
  path={`/roles/${role.slug}`}
  description={`Ally Madrone, ${role.label}. ${role.headline}.`}
>
  <p class="kicker">Ally Madrone · {role.label}</p>
  <h1>{role.headline}</h1>

  {role.summary.map((p, i) => <p class={i === 0 ? 'lede' : undefined}>{p}</p>)}

  <h2>{role.secondTitle}</h2>
  <ul>
    {role.second.map((r) => <li>{r}</li>)}
  </ul>

  <h2>Experience</h2>
  <dl class="record">
    {role.experience.map(([id, ids, opts = {}]) => <CvRole id={id} ids={ids} scope={opts.scope} />)}
  </dl>
  <p>
    Every role and date is on the <a href="/experience">full CV</a>.
  </p>

  <CvTail />

  <h2>Talk to me</h2>
  <p>
    <a href="/contact">Get in touch</a>. How I operate day to day is on
    <a href="/working-with-me">working with me</a>.
  </p>
</Base>
