---
import Base from '../layouts/Base.astro';
import CvRole from '../components/CvRole.astro';
import CvTail from '../components/CvTail.astro';
import { ENTITY_STATEMENT } from '../data/site.js';
import { CV_SUMMARY, WORK, SKILLS } from '../data/cv.js';
---

<Base
  title="Experience"
  path="/experience"
  description={`${ENTITY_STATEMENT} His complete CV: every role with dates and outcomes, skills, speaking, affiliations, and credentials.`}
>
  <h1>Experience</h1>
  <p class="kicker">
    The complete CV. A machine-readable version lives at <a href="/resume.json">/resume.json</a>
    (JSON Resume schema).
  </p>

  {CV_SUMMARY.map((p, i) => <p class={i === 0 ? 'lede' : undefined}>{p}</p>)}

  <h2>Experience</h2>
  <dl class="record">
    {WORK.map((w) => <CvRole id={w.id} scope={true} />)}
  </dl>

  <h2>Skills</h2>
  <ul>
    {SKILLS.map((s) => <li>{s}</li>)}
  </ul>

  <CvTail />
</Base>
