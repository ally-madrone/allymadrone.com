---
import Base from '../layouts/Base.astro';
import { ENTITY_STATEMENT } from '../data/site.js';
import { ROLES } from '../data/roles.js';
---

<Base
  title="Roles"
  path="/roles"
  description={`${ENTITY_STATEMENT} His experience read for product leadership, sales leadership, enterprise sales, and founder roles.`}
>
  <h1>Roles</h1>
  <p class="kicker">One career, read four ways.</p>

  <p class="lede">
    I've worked in product, in sales, and as a founder, usually more than one at a time. Each page
    below pulls the parts of the record that matter for one kind of role. The facts are the same on
    every page; only the emphasis changes.
  </p>

  <ul class="doors">
    {
      ROLES.map((r) => (
        <li>
          <a href={`/roles/${r.slug}`}>
            <strong>{r.label}</strong>
            <span>{r.blurb}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <p>
    The complete timeline is on the <a href="/experience">experience</a> page. To talk about a role,
    <a href="/contact">get in touch</a>.
  </p>
</Base>
